{
    auto_https off
    admin off
}

:{$PORT} {
    # MAPPS-963: `_mokosh_config.js`, `_mokosh_config.json` and the
    # link-preview-patched `index.html` are rendered by entrypoint.sh
    # into `$MOKOSH_RUNTIME_DIR` (default /tmp/mokosh-runtime) so the
    # image works as any non-root uid rather than owning
    # /usr/share/caddy. A named matcher routes those three paths at
    # that root; everything else (hashed /assets, /wasm, favicons,
    # the PWA manifest) stays at the compile-time bundle root. The
    # SPA fallback rewrites to /index.html before matching, so
    # client-side routes also pick up the patched copy.
    # The site root, which the `file` matchers in the header rules below
    # resolve against. The handlers that serve a request pick their own.
    root * /usr/share/caddy
    encode gzip zstd

    # The three runtime-rendered files, by exact path.
    @runtime path /_mokosh_config.js /_mokosh_config.json /index.html
    handle @runtime {
        root * {$MOKOSH_RUNTIME_DIR:/tmp/mokosh-runtime}
        file_server
    }

    handle {
        # Anything with a file on disk is a compile-time bundle asset:
        # hashed /assets and /wasm, the favicons, the PWA manifest.
        @bundled file {path}
        handle @bundled {
            file_server
        }

        # MAPPS-1125: the SPA fallback, which has to resolve against the
        # RUNTIME directory and not the bundle. `root` is evaluated long
        # before `try_files` rewrites the path, so the previous
        # `try_files {path} /index.html` sitting under `root * /usr/share/caddy`
        # served the PRISTINE index.html for `/` and for every client-side
        # route: no link-preview metadata and, worse, no `_mokosh_config.js`
        # script tag, because the entrypoint injects both into the runtime
        # copy only. `/index.html` was the one URL that got the patched page,
        # and nobody types that. Rewriting inside a handle whose own root is
        # the runtime directory is what makes the fallback serve the file the
        # entrypoint actually wrote.
        handle {
            root * {$MOKOSH_RUNTIME_DIR:/tmp/mokosh-runtime}
            rewrite * /index.html
            file_server
        }
    }

    # MAPPS-814: parity fallback for the `msp.<tld>` host-prefix derivation
    # `src/hooks/fetch.rs::api_base()` and `src/modules/oidc/config.rs::resolve()`
    # do client-side when no MOKOSH_API_BASE/MOKOSH_OIDC_ISSUER is configured.
    # entrypoint.sh cannot know that hostname at container start (one image
    # serves every deployment), but Caddy sees it on every request as the
    # `Host` header, so these `map`s recompute the same derivation the SPA
    # would make for THIS request. entrypoint.sh only reaches into
    # `{mokosh_*_origin_fallback}` when the matching MOKOSH_* var is unset;
    # an operator-set origin always wins (see MOKOSH_API_ORIGIN/
    # MOKOSH_OIDC_ORIGIN export in entrypoint.sh). A non-`msp.`-prefixed host
    # maps to "", same as the SPA deriving nothing.
    map {http.request.host} {mokosh_api_origin_fallback} {
        ~^msp\.(.+)$ "https://api.msp.${1}"
        default ""
    }
    map {http.request.host} {mokosh_oidc_origin_fallback} {
        ~^msp\.(.+)$ "https://api.${1}"
        default ""
    }

    header {
        # Default: never pin a response in the browser. index.html, the
        # runtime-config shim, and every client-side route (served
        # index.html via `try_files`, i.e. a path with no file on disk)
        # must always revalidate. Caching a route response `immutable` is
        # what let a stale/corrupted /auth/callback page survive both a
        # redeploy and a server restart (PMS-687): a browser cache cannot
        # be cleared by restarting the server. Content-addressed build
        # assets opt back into long-lived caching below.
        ?Cache-Control "no-cache, no-store, must-revalidate"

        # Security hardening headers (MAPPS-308). Sent on every response.
        # These four are safe to hardcode because they do not depend on the
        # runtime-configured OIDC/API origins:
        #   - frame-ancestors 'none' + X-Frame-Options DENY: block framing,
        #     defeating clickjacking of the authenticated SPA.
        #   - X-Content-Type-Options nosniff: stop MIME-type sniffing.
        #   - Referrer-Policy: do not leak full URLs (which may carry the
        #     return_to path / state) to cross-origin destinations.
        # MAPPS-338 / MAPPS-369: full content CSP from runtime env. connect-src
        # must allow the API and OIDC ORIGINS (scheme://host[:port]) so every
        # sub-path matches; a source that carries a path (e.g. ".../api/v1") is
        # a CSP exact-path match and would block every real API call. So
        # entrypoint.sh derives MOKOSH_API_ORIGIN / MOKOSH_OIDC_ORIGIN from the
        # operator's MOKOSH_API_BASE / MOKOSH_OIDC_ISSUER and exports them;
        # Caddy expands `{$VAR:}` (empty default - note the single colon; `:-`
        # would default to a literal "-") at config load. An empty origin drops
        # out, leaving 'self' for the same-origin dev case (relative
        # `/api/v1`). The canonical `msp.<tld>` deploy is cross-origin (SPA
        # `msp.<tld>` calls API `api.msp.<tld>`); when MOKOSH_API_BASE /
        # MOKOSH_OIDC_ISSUER are unset, entrypoint.sh exports the
        # `{mokosh_*_origin_fallback}` map placeholders defined above instead
        # of an empty string, so a zero-config `msp.<tld>` deploy still gets
        # the SPA's own derived origin here (MAPPS-814) rather than only
        # 'self'.
        #
        # PMS-758: `img-src` carries the same origin. The tenant logo
        # (MAPPS-429) is served BY the API, and the browser blocked it on
        # `img-src 'self' data:` even once its URL was right, because the SPA
        # and the API are different origins by construction on every deployed
        # environment. `'wasm-unsafe-eval'` is required because Dioxus boots through
        # `WebAssembly.instantiate` in a code path Chromium's strict CSP
        # enforces against; `'unsafe-inline'` on style-src covers Tailwind's
        # small inline `style="..."` usages.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: {$MOKOSH_API_ORIGIN:}; font-src 'self' data:; connect-src 'self' {$MOKOSH_API_ORIGIN:} {$MOKOSH_OIDC_ORIGIN:}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Strip the server banner so the Caddy version is not advertised.
        -Server
    }
    # Content-addressed build assets opt back into long-lived caching.
    # dx emits JS/WASM/CSS under /assets and /wasm with a content hash in
    # the filename, so a new build ships new URLs - safe to cache for a
    # year. Caddy's path matcher sees the pre-`try_files` request URI
    # (a missing asset that falls back to index.html keeps its original
    # non-matching path), so index.html and every client-side route stay
    # no-cache via the default above.
    @immutable {
        path /assets/* /wasm/*
        file {path}
    }
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    # `theme-init.js` and `scrollbar-autohide.js` (MAPPS-970) are the
    # stable-named (non-hashed) scripts under /assets - raw <script src>
    # tags in index.html, not `asset!()` - so they must keep revalidating.
    # Excepted back to no-cache after the immutable block (a later
    # matching header directive wins).
    @stable-asset path /assets/theme-init.js /assets/scrollbar-autohide.js
    header @stable-asset Cache-Control "no-cache, no-store, must-revalidate"
    # MAPPS-852: root-path icons (favicon.svg, apple-touch-icon.png, the PWA
    # manifest's icon-*.png set) are not content-hashed, so they cannot join
    # @immutable above - a future icon change needs to propagate. But they
    # are also not the SPA shell, so they do not need the no-store default's
    # revalidate-on-redeploy guarantee either. A day-long max-age still cuts
    # the refetch on every navigation without risking a long-lived stale copy.
    @icons path /favicon.svg /icon-*.png /apple-touch-icon.png
    header @icons Cache-Control "max-age=86400"
}
