{
    auto_https off
    admin off
}

:{$PORT} {
    root * /usr/share/caddy
    encode gzip zstd

    # SPA fallback: serve index.html for missing files (client-side routing)
    try_files {path} /index.html

    file_server

    header {
        # Cache hashed assets (wasm/js/css) aggressively
        ?Cache-Control "public, max-age=31536000, immutable"

        # Security hardening headers (MAPPS-308). Sent on every response.
        # These four are safe to hardcode because they do not depend on the
        # runtime-configured OIDC/API origins:
        #   - frame-ancestors 'none' + X-Frame-Options DENY: block framing,
        #     defeating clickjacking of the authenticated SPA.
        #   - X-Content-Type-Options nosniff: stop MIME-type sniffing.
        #   - Referrer-Policy: do not leak full URLs (which may carry the
        #     return_to path / state) to cross-origin destinations.
        # A full content CSP (script-src/connect-src) is intentionally NOT
        # set here: connect-src must allow the OIDC provider and API origins,
        # which entrypoint.sh injects into _mokosh_config.js at container
        # start and are therefore unknown at build time. Hardcoding a strict
        # connect-src would break sign-in. The residual risk (a permissive
        # connect-src) was reviewed and risk-accepted in the 2026-06-25 security audit.
        # MAPPS-338 / MAPPS-369: full content CSP from runtime env. connect-src
        # must allow the API and OIDC ORIGINS (scheme://host[:port]) so every
        # sub-path matches; a source that carries a path (e.g. ".../api/v1") is
        # a CSP exact-path match and would block every real API call. So
        # entrypoint.sh derives MOKOSH_API_ORIGIN / MOKOSH_OIDC_ORIGIN from the
        # operator's MOKOSH_API_BASE / MOKOSH_OIDC_ISSUER and exports them;
        # Caddy expands `{$VAR:}` (empty default - note the single colon; `:-`
        # would default to a literal "-") at config load. An empty origin drops
        # out, leaving 'self' for the same-origin dev case (relative
        # `/api/v1`). The canonical `msp.<tld>` deploy is cross-origin (SPA
        # `msp.<tld>` calls API `api.msp.<tld>`), so it must set MOKOSH_API_BASE
        # (its entrypoint does) for that origin to be allowed here; relying on
        # the SPA's runtime host-prefix derivation alone would leave connect-src
        # without the API origin. `'wasm-unsafe-eval'` is required because Dioxus boots through
        # `WebAssembly.instantiate` in a code path Chromium's strict CSP
        # enforces against; `'unsafe-inline'` on style-src covers Tailwind's
        # small inline `style="..."` usages.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' {$MOKOSH_API_ORIGIN:} {$MOKOSH_OIDC_ORIGIN:}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Strip the server banner so the Caddy version is not advertised.
        -Server
    }
    # index.html and the runtime-config shim are regenerated per
    # container start, so they must never be cached. The bare `/`
    # match is needed because Caddy's path matcher evaluates the
    # request URI before `try_files` rewrites it, so a request to `/`
    # would otherwise miss the `*.html` glob and pick up the
    # immutable header from the block above.
    @no-cache path / *.html /_mokosh_config.js
    header @no-cache Cache-Control "no-cache, no-store, must-revalidate"
}
