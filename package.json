{
  "name": "mokosh-platform",
  "version": "0.17.0",
  "private": true,
  "scripts": {
    "build:css": "bun x @tailwindcss/cli -i ./input.css -o ./assets/styles.css --minify",
    "watch:css": "bun x @tailwindcss/cli -i ./input.css -o ./assets/styles.css --watch",
    "dev": "concurrently \"bun x @tailwindcss/cli -i ./input.css -o ./assets/styles.css --watch\" \"dx serve --features web\"",
    "build": "bun run build:css && dx build --release --features web"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5"
  }
}